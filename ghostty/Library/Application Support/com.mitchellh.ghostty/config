# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
font-family = "Jetbrain Mono"


# MAPLE MONO FONT SETTING
font-family = "Maple Mono NF"
# font-family = Literata
# font-family = Departure Mono
# font-family = Fira Code
font-size = 14

# Ligatures
font-feature = calt
font-feature = liga

# Character shape improvements
font-feature = cv02   # alternative 'a' with top arm
font-feature = cv03   # 'i' without left bottom bar
font-feature = cv05   # double-story 'g'
font-feature = cv09   # '7' with middle bar
font-feature = cv10   # 'Z'/'z' with middle bar
font-feature = ss05   # thinner backslash in escape sequences
font-feature = zero   # dot-style zero

# Extra ligatures
font-feature = ss07   # relaxed >> >>> ligatures
font-feature = ss08   # double-headed/reverse arrows
font-feature = ss09   # ~= as not-equal
font-feature = ss10   # =~ and !~ ligatures
font-feature = ss11   # |= /= ?= &= ligatures

# Variable font weight (slightly bolder than default 400)
font-variation = wght=420

# Rendering
font-thicken = true
font-thicken-strength = 30
alpha-blending = linear-corrected

# Transparency (lets tmux's bg=default / rose-pine's bar_bg_disable show through)
background-opacity = 0
background-blur = true

# Cell spacing
# adjust-cell-height = 20%




